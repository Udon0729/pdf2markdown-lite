# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Build artifacts
dist/
build/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Local scratch
work/

# --- Generated converter output at the repo root ---
# The CLI writes <name>.md, <name>.artifacts.json and <name>_assets/ next to the
# output path. Ignore generated copies, but keep the committed sample output
# (output.*) and the project docs (README.md, CLAUDE.md).
/*.md
!/README.md
!/CLAUDE.md
!/output.md
/*.artifacts.json
!/output.artifacts.json
/*_assets/
!/output_assets/

# Local test input PDFs (papers) are not part of the repository.
/*.pdf
