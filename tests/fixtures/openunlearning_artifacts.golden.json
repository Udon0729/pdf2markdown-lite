        ],
        [
          "Unlearning algorithms",
          "GradAscent, GradDiff, IdkDPO, IdkNLL [39] NPO [76] SimNPO [16] RMU [33] UNDIAL [11] AltPO [40] CE-U [71] PDU [15] WGA [64] SatImp [73]"
        ],
        [
          "Datasets",
          "TOFU: bios [39] WMDP: cyber, bio [33] MUSE: news, books [52]"
        ],
