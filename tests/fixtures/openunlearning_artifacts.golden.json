[
  {
    "id": "page-0003-figure-01",
    "page": 3,
    "kind": "figure",
    "bbox": [
      103.9,
      49.2,
      503.6,
      274.0
    ],
    "caption": "Figure 1: OpenUnlearning is an extensible library for benchmarking LLM unlearning methods and metrics. It provides a unified framework for implementing unlearning methods, unlearning metrics, and stress-testing tools to verify unlearning robustness. This figure illustrates the unlearning pipeline in terms of implementation-level components.",
    "table": null
  },
